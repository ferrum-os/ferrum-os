FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      git-core gnupg flex bison gperf build-essential \
      zip curl zlib1g-dev zlib1g:i386 \
      libc6-dev lib32ncurses6 lib32ncurses-dev x11proto-core-dev \
      libx11-dev lib32z1 lib32z1-dev ccache libgl1-mesa-dev \
      libxml2-utils xsltproc unzip \
      python2 python3 \
      openjdk-8-jdk \
      ca-certificates \
    && ln -sf /usr/bin/python2 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/java-shim

COPY <<'EOF' /opt/java-shim/java
#!/bin/bash
if [ "$1" = "-version" ]; then
  echo 'java version "1.5.0_22"' >&2
  exit 0
fi
exec /usr/lib/jvm/java-8-openjdk-amd64/bin/java "$@"
EOF

COPY <<'EOF' /opt/java-shim/javac
#!/bin/bash
if [ "$1" = "-version" ]; then
  echo 'javac 1.5.0_22' >&2
  exit 0
fi

args=("$@")
has_source=0
target_val=""
for a in "${args[@]}"; do
  [ "$a" = "-source" ] && has_source=1
done
for i in "${!args[@]}"; do
  if [ "${args[$i]}" = "-target" ]; then
    next=$((i + 1))
    target_val="${args[$next]}"
    break
  fi
done
if [ "$has_source" = "0" ] && [ -n "$target_val" ]; then
  args=("-source" "$target_val" "${args[@]}")
fi
exec /usr/lib/jvm/java-8-openjdk-amd64/bin/javac "${args[@]}"
EOF

RUN chmod +x /opt/java-shim/java /opt/java-shim/javac
ENV PATH="/opt/java-shim:${PATH}"

RUN curl -o /usr/local/bin/repo https://storage.googleapis.com/git-repo-downloads/repo && \
    chmod a+x /usr/local/bin/repo

WORKDIR /aosp
