FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      git-core gnupg flex bison gperf build-essential \
      zip curl zlib1g-dev zlib1g:i386 \
      libc6-dev lib32ncurses6 lib32ncurses-dev x11proto-core-dev \
      libx11-dev lib32z1 lib32z1-dev ccache libgl1-mesa-dev \
      libxml2-utils xsltproc unzip \
      python2 python3 \
      libswitch-perl \
      ca-certificates \
    && ln -sf /usr/bin/python2 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/jdk6 && \
    curl -fsSL https://cdn.azul.com/zulu/bin/zulu6.22.0.3-jdk6.0.119-linux_x64.tar.gz -o /tmp/zulu6.tar.gz && \
    tar -xzf /tmp/zulu6.tar.gz -C /opt/jdk6 --strip-components=1 && \
    rm /tmp/zulu6.tar.gz

RUN mkdir -p /opt/java-shim/bin /opt/java-shim/lib && \
    ln -sf /opt/jdk6/lib/tools.jar /opt/java-shim/lib/tools.jar

COPY <<'EOF' /opt/java-shim/bin/java
#!/bin/bash
if [ "$1" = "-version" ]; then
  echo 'java version "1.5.0_22"' >&2
  exit 0
fi
exec /opt/jdk6/bin/java "$@"
EOF

COPY <<'EOF' /opt/java-shim/bin/javac
#!/bin/bash
if [ "$1" = "-version" ]; then
  echo 'javac 1.5.0_22' >&2
  exit 0
fi
exec /opt/jdk6/bin/javac "$@"
EOF

RUN chmod +x /opt/java-shim/bin/java /opt/java-shim/bin/javac

ENV PATH="/opt/java-shim/bin:/opt/jdk6/bin:${PATH}"
ENV JAVA_HOME=/opt/jdk6

RUN mkdir -p /opt/cc-shim/bin
COPY <<'EOF' /opt/cc-shim/bin/cc-shim-wrapper
#!/bin/bash
# $1 is the real compiler this wrapper stands in for (cc/gcc/g++/c++).
real="$1"; shift
has_E=0
for a in "$@"; do
  [ "$a" = "-E" ] && has_E=1
done
if [ "$has_E" = "1" ]; then
  exec "$real" -P "$@"
fi
exec "$real" "$@"
EOF
RUN chmod +x /opt/cc-shim/bin/cc-shim-wrapper && \
    for name in cc gcc c++ g++; do \
      real="$(command -v "$name")" && \
      printf '#!/bin/bash\nexec /opt/cc-shim/bin/cc-shim-wrapper %s "$@"\n' "$real" > "/opt/cc-shim/bin/$name" && \
      chmod +x "/opt/cc-shim/bin/$name"; \
    done
ENV PATH="/opt/cc-shim/bin:${PATH}"

RUN curl -fsSL https://www.cpan.org/src/5.0/perl-5.14.4.tar.gz -o /tmp/perl514.tar.gz && \
    mkdir -p /tmp/perl-build && \
    tar -xzf /tmp/perl514.tar.gz -C /tmp/perl-build --strip-components=1 && \
    cd /tmp/perl-build && \
    ./Configure -des -Dprefix=/opt/perl514 -Accflags='-fno-strict-aliasing -fwrapv' && \
    make -j"$(nproc)" && \
    make install && \
    cd / && rm -rf /tmp/perl-build /tmp/perl514.tar.gz

RUN curl -fsSL https://cpanmin.us | /opt/perl514/bin/perl - --notest Switch

ENV PATH="/opt/perl514/bin:${PATH}"

RUN curl -o /usr/local/bin/repo https://storage.googleapis.com/git-repo-downloads/repo && \
    chmod a+x /usr/local/bin/repo

WORKDIR /aosp
