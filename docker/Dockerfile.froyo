FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      git-core gnupg flex bison gperf build-essential \
      zip curl zlib1g-dev zlib1g:i386 \
      libc6-dev lib32ncurses6 lib32ncurses-dev x11proto-core-dev \
      libx11-dev lib32z1 lib32z1-dev ccache libgl1-mesa-dev \
      libxml2-utils xsltproc unzip \
      python2 python3 \
      ca-certificates \
    && ln -sf /usr/bin/python2 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/jdk6 && \
    curl -fsSL https://cdn.azul.com/zulu/bin/zulu6.22.0.3-jdk6.0.119-linux_x64.tar.gz -o /tmp/zulu6.tar.gz && \
    tar -xzf /tmp/zulu6.tar.gz -C /opt/jdk6 --strip-components=1 && \
    rm /tmp/zulu6.tar.gz

RUN mkdir -p /opt/java-shim

COPY <<'EOF' /opt/java-shim/java
#!/bin/bash
if [ "$1" = "-version" ]; then
  echo 'java version "1.5.0_22"' >&2
  exit 0
fi
exec /opt/jdk6/bin/java "$@"
EOF

COPY <<'EOF' /opt/java-shim/javac
#!/bin/bash
if [ "$1" = "-version" ]; then
  echo 'javac 1.5.0_22' >&2
  exit 0
fi
exec /opt/jdk6/bin/javac "$@"
EOF

RUN chmod +x /opt/java-shim/java /opt/java-shim/javac

ENV PATH="/opt/java-shim:/opt/jdk6/bin:${PATH}"

ENV JAVA_HOME=/opt/jdk6

RUN curl -o /usr/local/bin/repo https://storage.googleapis.com/git-repo-downloads/repo && \
    chmod a+x /usr/local/bin/repo

WORKDIR /aosp
